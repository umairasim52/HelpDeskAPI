@page "/"

@using HelpDeskBlazor.Services
@using Microsoft.AspNetCore.Components

<h2 class="mb-4 fw-bold text-primary">
    📊 Dashboard
</h2>

<div class="row g-4">

    <div class="col-md-3">

        <NavLink href="/departments" class="text-decoration-none">
            <div class="card shadow border-0 rounded-4 text-center p-4 h-100 dashboard-card">
                <h1 class="mb-3">🏢</h1>
                <h5 class="fw-bold">Departments</h5>
                <h3 class="text-primary">Manage</h3>
            </div>
        </NavLink>

    </div>

    <div class="col-md-3">

        <NavLink href="/employees" class="text-decoration-none">
            <div class="card shadow border-0 rounded-4 text-center p-4 h-100 dashboard-card">
                <h1 class="mb-3">👥</h1>
                <h5 class="fw-bold">Employees</h5>
                <h3 class="text-success">Manage</h3>
            </div>
        </NavLink>

    </div>

    <div class="col-md-3">

        <NavLink href="/tickets" class="text-decoration-none">
            <div class="card shadow border-0 rounded-4 text-center p-4 h-100 dashboard-card">
                <h1 class="mb-3">🎫</h1>
                <h5 class="fw-bold">Tickets</h5>
                <h3 class="text-danger">Manage</h3>
            </div>
        </NavLink>

    </div>

    <div class="col-md-3">

        <NavLink href="/reports" class="text-decoration-none">
            <div class="card shadow border-0 rounded-4 text-center p-4 h-100 dashboard-card">
                <h1 class="mb-3">📈</h1>
                <h5 class="fw-bold">Reports</h5>
                <h3 class="text-warning">View</h3>
            </div>
        </NavLink>

    </div>

</div>

<div class="card shadow border-0 rounded-4 mt-5">

    <div class="card-body p-4">

        <h3 class="text-primary mb-3">
            👋 Welcome to Help Desk Management System
        </h3>

        <p class="text-secondary">
            This system is developed using <strong>ASP.NET Core Web API</strong>,
            <strong>Entity Framework Core</strong>, <strong>SQL Server</strong>,
            <strong>AutoMapper</strong> and <strong>Blazor Server</strong>.
        </p>

        <div class="row g-3 mt-3">
            <div class="col-md-3">
                <div class="p-3 bg-light rounded">
                    <small class="text-muted">Departments</small>
                    <h4 class="text-primary">@totalDepartments</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded">
                    <small class="text-muted">Employees</small>
                    <h4 class="text-success">@totalEmployees</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded">
                    <small class="text-muted">Tickets</small>
                    <h4 class="text-danger">@totalTickets</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded">
                    <small class="text-muted">Open Tickets</small>
                    <h4 class="text-warning">@openTickets</h4>
                </div>
            </div>
        </div>

    </div>

</div>

<style>
    .dashboard-card {
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .dashboard-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.12) !important;
        }

        .dashboard-card h1 {
            font-size: 3rem;
            line-height: 1;
        }

        .dashboard-card h5 {
            color: #0f172a;
            font-weight: 700;
        }

        .dashboard-card h3 {
            font-weight: 700;
        }
</style>

@code {
    private int totalDepartments = 0;
    private int totalEmployees = 0;
    private int totalTickets = 0;
    private int openTickets = 0;

    [Inject]
    private DepartmentService? DepartmentService { get; set; }

    [Inject]
    private EmployeeService? EmployeeService { get; set; }

    [Inject]
    private TicketService? TicketService { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (DepartmentService != null)
            {
                var depts = await DepartmentService.GetDepartments();
                totalDepartments = depts?.Count ?? 0;
            }

            if (EmployeeService != null)
            {
                var emps = await EmployeeService.GetEmployees();
                totalEmployees = emps?.Count ?? 0;
            }

            if (TicketService != null)
            {
                var tix = await TicketService.GetTickets();
                totalTickets = tix?.Count ?? 0;
                openTickets = tix?.Count(t => t.Status?.ToLower() == "open" || t.Status?.ToLower() == "in progress") ?? 0;
            }
        }
        catch (Exception)
        {
            // Silent fail - dashboard stats will show 0
        }
    }
}