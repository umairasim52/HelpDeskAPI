@page "/departments"
@using HelpDeskBlazor.Models
@using HelpDeskBlazor.Services
@using Microsoft.JSInterop
@inject DepartmentService DepartmentService
@inject IJSRuntime JSRuntime

<div class="card shadow mb-4 border-0">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">🏢 Department Management</h3>
    </div>
    <div class="card-body">
        <p class="text-muted">Add, Update and Delete Departments</p>
    </div>
</div>

<div class="card shadow border-0 mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <label class="form-label fw-bold">Department Name *</label>
                <input class="form-control" @bind="department.DepartmentName" placeholder="Enter department name" />
                @if (string.IsNullOrWhiteSpace(department.DepartmentName) && attemptedSubmit)
                {
                    <small class="text-danger">Department name is required</small>
                }
            </div>
        </div>
        <div class="mt-3">
            @if (department.Id == 0)
            {
                <button class="btn btn-success" @onclick="SaveDepartment">➕ Add Department</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="UpdateDepartment">💾 Update</button>
                <button class="btn btn-secondary ms-2" @onclick="Cancel">❌ Cancel</button>
            }
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(messageType == "success" ? "alert-success" : "alert-danger") mt-3">
                @message
            </div>
        }
    </div>
</div>

<div class="card shadow border-0">
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
                <p class="mt-2 text-muted">Loading departments...</p>
            </div>
        }
        else if (departments.Count == 0)
        {
            <div class="text-center py-4">
                <h5 class="text-muted">No departments found</h5>
                <p class="text-muted">Add your first department using the form above.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Department Name</th>
                            <th width="180">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in departments)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.DepartmentName</td>
                                <td>
                                    <button class="btn btn-warning btn-sm" @onclick="(() => Edit(item))">✏️ Edit</button>
                                    <button class="btn btn-danger btn-sm ms-2" @onclick="(() => Delete(item.Id))">🗑️ Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<Department> departments = new();
    private Department department = new();
    private bool isLoading = true;
    private bool attemptedSubmit = false;
    private string message = "";
    private string messageType = "";

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        isLoading = true;
        try
        {
            departments = await DepartmentService.GetDepartments();
        }
        catch (Exception ex)
        {
            message = $"❌ Error: {ex.Message}";
            messageType = "error";
        }
        finally { isLoading = false; }
    }

    private async Task SaveDepartment()
    {
        attemptedSubmit = true;
        message = "";
        if (string.IsNullOrWhiteSpace(department.DepartmentName)) return;
        try
        {
            await DepartmentService.AddDepartment(department);
            message = $"✅ Department '{department.DepartmentName}' added successfully!";
            messageType = "success";
            department = new Department();
            attemptedSubmit = false;
            await Load();
        }
        catch (Exception ex)
        {
            message = $"❌ Error: {ex.Message}";
            messageType = "error";
        }
    }

    private void Edit(Department d)
    {
        department = new Department { Id = d.Id, DepartmentName = d.DepartmentName };
        attemptedSubmit = false;
        message = "";
    }

    private async Task UpdateDepartment()
    {
        attemptedSubmit = true;
        message = "";
        if (string.IsNullOrWhiteSpace(department.DepartmentName)) return;
        try
        {
            await DepartmentService.UpdateDepartment(department);
            message = $"✅ Department '{department.DepartmentName}' updated successfully!";
            messageType = "success";
            department = new Department();
            attemptedSubmit = false;
            await Load();
        }
        catch (Exception ex)
        {
            message = $"❌ Error: {ex.Message}";
            messageType = "error";
        }
    }

    private async Task Delete(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Delete this department?"))
        {
            try
            {
                var name = departments.FirstOrDefault(d => d.Id == id)?.DepartmentName ?? "Department";
                await DepartmentService.DeleteDepartment(id);
                message = $"✅ Department '{name}' deleted successfully!";
                messageType = "success";
                await Load();
            }
            catch (Exception ex)
            {
                message = $"❌ Error: {ex.Message}";
                messageType = "error";
            }
        }
    }

    private void Cancel()
    {
        department = new Department();
        attemptedSubmit = false;
        message = "";
    }
}